+    #[tokio::test(start_paused = true)]
+    async fn known_fake_ip_forwards_the_first_quic_datagram_to_the_assigned_exit_immediately() {
+        let config = Config::parse(
+            r#"{
+            "inbounds":[{"type":"tun","tag":"tun","sniff":true}],
+            "outbounds":[{"type":"direct","tag":"media-exit"},{"type":"block","tag":"other"}],
+            "dns":{"servers":[
+                {"tag":"remote","address":"127.0.0.1:53","detour":"media-exit"},
+                {"tag":"fake","address":"fakeip"}
+            ],"final":"remote"},
+            "route":{"final":"other","rules":[{"domain":["media.example"],"outbound":"media-exit"}]}
+        }"#,
+        )
+        .unwrap();
+        let app = App::build(&config).unwrap();
+        let dns = app.routers.get().dns().unwrap().clone();
+        let fake = dns.fakeip().unwrap().ipv4_for("media.example");
+
+        let (packets, mut sent) = mpsc::channel(1);
+        let geo =
+            GeoFiles::load(Vec::new(), Vec::new(), "unused".as_ref(), "unused".as_ref()).unwrap();
+        let mut router = Router::new(
+            vec![
+                Arc::new(MediaExit(packets)),
+                Arc::new(BlockOutbound::new("other")),
+            ],
+            &config.route,
+            &["tun".into()],
+            &geo,
+        )
+        .unwrap();
+        router.set_dns(dns);
+        let inbound = TunInbound {
+            tag: "tun".into(),
+            settings: settings(&config.inbounds[0]).unwrap(),
+        };
+        assert!(inbound.settings.sniff);
+        let packet = incomplete_initial_datagram();
+        let (replies, _replies_rx) = mpsc::channel(1);
+        let (accept, mut accepted) = mpsc::channel(1);
+        let mut flows = HashMap::new();
+        assert!(open(
+            &mut flows,
+            (
+                "172.19.0.2:54321".parse().unwrap(),
+                SocketAddr::from((fake, 443))
+            ),
+            packet.clone(),
+            &Arc::new(Semaphore::new(1)),
+            UDP_IDLE,
+            &replies,
+            &accept,
+        ));
+        let flow = accepted.recv().await.unwrap();
+        let tunnel = tokio::spawn(async move { inbound.udp(flow, &router).await });
+        let first = tokio::time::timeout(Duration::from_millis(50), sent.recv()).await;
+        tunnel.abort();
+        assert_eq!(
+            first.expect("a known destination must not wait for more QUIC fragments"),
+            Some((Address::Domain("media.example".into()), 443, packet)),
+        );
+    }
