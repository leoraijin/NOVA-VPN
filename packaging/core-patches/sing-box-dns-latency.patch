+// Allow both families to contribute while bounding the extra wait once an address
+// is ready. Keep IPv4/IPv6 preference and the caller's selected DNS transport.
+const addressFamilyGrace = 150 * time.Millisecond
+
+func lookupAddressFamilies(ctx context.Context, strategy C.DomainStrategy, lookup func(context.Context, uint16) ([]netip.Addr, error)) ([]netip.Addr, error) {
+	queryCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	type result struct {
+		addresses []netip.Addr
+		err       error
+		qtype     uint16
+	}
+	results := make(chan result, 2)
+	query := func(ctx context.Context, qtype uint16) {
+		addresses, err := lookup(ctx, qtype)
+		results <- result{addresses, err, qtype}
+	}
+	// A cancelled lookup can finish asynchronously. Give each query its own
+	// inbound metadata before it starts, separate from the caller's route state.
+	go query(adapter.OverrideContext(queryCtx), dns.TypeA)
+	go query(adapter.OverrideContext(queryCtx), dns.TypeAAAA)
+
+	var first result
+	select {
+	case first = <-results:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	var grace <-chan time.Time
+	if len(first.addresses) > 0 {
+		timer := time.NewTimer(addressFamilyGrace)
+		defer timer.Stop()
+		grace = timer.C
+	}
+
+	var second result
+	select {
+	case second = <-results:
+	case <-grace:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	if err := ctx.Err(); err != nil {
 		return nil, err
 	}
-	return sortAddresses(response4, response6, strategy), nil
