@@ -0,0 +1,51 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func TestNovaAddressFamilies(t *testing.T) {
+	ipv4 := netip.MustParseAddr("192.0.2.15")
+	ipv6 := netip.MustParseAddr("2001:db8::15")
+	badReply := errors.New("unusable response")
+
+	for _, tc := range []struct {
+		name     string
+		strategy C.DomainStrategy
+		results  map[uint16][]netip.Addr
+		errors   map[uint16]error
+		expected []netip.Addr
+	}{
+		{"stalled IPv6", C.DomainStrategyPreferIPv6, map[uint16][]netip.Addr{dns.TypeA: {ipv4}}, nil, []netip.Addr{ipv4}},
+		{"stalled IPv4", C.DomainStrategyPreferIPv4, map[uint16][]netip.Addr{dns.TypeAAAA: {ipv6}}, nil, []netip.Addr{ipv6}},
+		{"invalid IPv6", C.DomainStrategyPreferIPv6, map[uint16][]netip.Addr{dns.TypeA: {ipv4}}, map[uint16]error{dns.TypeAAAA: badReply}, []netip.Addr{ipv4}},
+		{"IP family order", C.DomainStrategyPreferIPv6, map[uint16][]netip.Addr{dns.TypeA: {ipv4}, dns.TypeAAAA: {ipv6}}, nil, []netip.Addr{ipv6, ipv4}},
+		{"IPv6 only answer", C.DomainStrategyPreferIPv4, map[uint16][]netip.Addr{dns.TypeA: nil, dns.TypeAAAA: {ipv6}}, nil, []netip.Addr{ipv6}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			addresses, err := lookupAddressFamilies(ctx, tc.strategy, func(ctx context.Context, qtype uint16) ([]netip.Addr, error) {
+				if addrs, ok := tc.results[qtype]; ok {
+					return addrs, nil
+				}
+				if err, ok := tc.errors[qtype]; ok {
+					return nil, err
+				}
+				<-ctx.Done()
+				return nil, ctx.Err()
+			})
+			if err != nil || !slices.Equal(addresses, tc.expected) {
+				t.Fatalf("addresses = %v, error = %v, want %v", addresses, err, tc.expected)
+			}
+		})
+	}
+}
